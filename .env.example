# Copy to ~/.config/changeguard/.env (used from any directory) or to a project .env.
# Real environment variables take precedence, then CHANGEGUARD_ENV_FILE or the nearest .env
# (current directory and parents, up to the git root), then ~/.config/changeguard/.env.

# GitHub token for private repositories or higher API rate limits (never sent to the browser).
# If unset, the logged-in GitHub CLI token is used (`gh auth login`); set CHANGEGUARD_USE_GH_TOKEN=0 to disable.
GITHUB_TOKEN=

# Where analyses and evidence are stored.
# CHANGEGUARD_DATABASE=~/.local/share/changeguard/changeguard.sqlite3

# LLM used when --llm is passed (CLI) or the LLM option is enabled (demo): ollama or gemini.
CHANGEGUARD_LLM_PROVIDER=ollama

# Gemini (only used when the provider is gemini).
GEMINI_API_KEY=
# CHANGEGUARD_GEMINI_MODEL=gemini-3.5-flash
# CHANGEGUARD_GEMINI_TIMEOUT_SECONDS=30
# CHANGEGUARD_GEMINI_MAX_REQUESTS=3
# CHANGEGUARD_GEMINI_MAX_OUTPUT_TOKENS=800
# Thinking level for Gemini 3 models (minimal/low/medium/high); leave empty for models without it.
# CHANGEGUARD_GEMINI_THINKING_LEVEL=low
# CHANGEGUARD_GEMINI_MAX_RETRIES=2

# Ollama (only used when the provider is ollama).
# CHANGEGUARD_OLLAMA_BASE_URL=http://127.0.0.1:11434
# CHANGEGUARD_MODEL=qwen2.5:1.5b
# CHANGEGUARD_OLLAMA_TIMEOUT_SECONDS=45

# Demo server (always bound to localhost).
# CHANGEGUARD_DEMO_HOST=127.0.0.1
# CHANGEGUARD_DEMO_PORT=8000
